{
  "__inputs": [{"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus"}],
  "annotations": {"list": []},
  "editable": true,
  "panels": [
    {"type": "stat", "title": "Estado última ejecución", "id": 1, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "cypress_run_success", "refId": "A"}], "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "FALLÓ", "color": "red"}, "1": {"text": "EXITOSA", "color": "green"}}}], "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "green", "value": 1}]}}, "overrides": []}, "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0}},
    {"type": "stat", "title": "Pruebas totales", "id": 2, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "cypress_tests_total", "refId": "A"}], "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0}},
    {"type": "stat", "title": "Aprobadas", "id": 3, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "cypress_tests_passed", "refId": "A"}], "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0}},
    {"type": "stat", "title": "Fallidas", "id": 4, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "cypress_tests_failed", "refId": "A"}], "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0}},
    {"type": "timeseries", "title": "Historial de resultados", "id": 5, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "cypress_tests_passed", "legendFormat": "Aprobadas", "refId": "A"}, {"expr": "cypress_tests_failed", "legendFormat": "Fallidas", "refId": "B"}, {"expr": "cypress_tests_skipped", "legendFormat": "Omitidas", "refId": "C"}], "gridPos": {"h": 8, "w": 16, "x": 0, "y": 5}},
    {"type": "timeseries", "title": "Duración por spec", "id": 6, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "cypress_spec_duration_seconds", "legendFormat": "{{spec}}", "refId": "A"}], "gridPos": {"h": 8, "w": 8, "x": 16, "y": 5}}
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["cypress", "testing"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "title": "Cypress - CEGOS",
  "uid": "cypress-cegos",
  "version": 1
}
